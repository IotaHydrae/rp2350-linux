
# S3-01 追加：AMO/LR/SC 模拟器（仅 01 启用）
CONFIG_RISCV_AMO_EMULATION=y
# RP2350 UART0 是 PL011：earlycon 需要 pl011 驱动（Kconfig 已放宽到 RISCV）
CONFIG_SERIAL_AMBA_PL011=y
# earlycon 的 OF_EARLYCON_DECLARE(pl011) 在 CONSOLE 选项内
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# 清掉 nommu_virt_defconfig 内置的 QEMU 命令行（CMDLINE_FORCE 会无视 DTB bootargs）
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE=""
# S2 构建配置碎片：riscv32 + NOMMU + M-mode（单核）
# 用法：make ARCH=riscv nommu_virt_defconfig 后，用 merge_config.sh 叠加本文件
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
# CONFIG_PORTABLE is not set
CONFIG_NONPORTABLE=y
# CONFIG_SMP is not set
